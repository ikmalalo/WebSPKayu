generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PengajuanStatus {
  DRAFT
  MENUNGGU_VERIFIKASI
  SEDANG_DIVERIFIKASI
  PERLU_PERBAIKAN
  LOLOS_VERIFIKASI
  DITOLAK
  DIPROSES_TOPSIS
  LAYAK_DIDANAI
  TIDAK_DIDANAI
}

enum KriteriaTipe {
  BENEFIT
  COST
}

enum VerifikasiStatus {
  LOLOS
  PERLU_PERBAIKAN
  DITOLAK
}

enum IndikatorTipe {
  POSITIF
  NEGATIF
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  phone        String?
  role         Role   @default(USER)

  mustahik      Mustahik?
  pengajuan     Pengajuan[]
  verifications Verifikasi[] @relation("Verifier")
  auditLogs     AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user")
}

model Mustahik {
  id     String @id @default(cuid())
  userId String @unique
  nik    String @unique

  namaLengkap  String
  tempatLahir  String?
  tanggalLahir DateTime?
  jenisKelamin String?

  alamat    String?
  kelurahan String?
  kecamatan String?
  kota      String?
  provinsi  String?

  noHp             String?
  statusPernikahan String?

  pekerjaan        String?
  penghasilan      Decimal? @db.Decimal(15, 2)
  jumlahTanggungan Int?
  statusRumah      String?
  kondisiRumah     String?
  kepemilikanAset  String?

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pengajuan Pengajuan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([namaLengkap])
  @@map("mustahik")
}

model Pengajuan {
  id String @id @default(cuid())

  userId     String
  mustahikId String

  status  PengajuanStatus @default(DRAFT)
  catatan String?

  tanggalPengajuan  DateTime  @default(now())
  tanggalVerifikasi DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mustahik Mustahik @relation(fields: [mustahikId], references: [id], onDelete: Restrict)

  jawaban       JawabanKuesioner[]
  verifications Verifikasi[]
  topsisResults TopsisResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([mustahikId])
  @@map("pengajuan")
}

model Kriteria {
  id String @id @default(cuid())

  kode      String       @unique
  nama      String       @unique
  bobot     Decimal      @db.Decimal(8, 4)
  tipe      KriteriaTipe
  deskripsi String?
  aktif     Boolean      @default(true)

  dimensi String
  urutan   Int

  indikator     Indikator[]
  subKriteria   SubKriteria[]
  topsisDetails TopsisDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dimensi, urutan])
  @@index([dimensi])
  @@map("kriteria")
}

model Indikator {
  id String @id @default(cuid())

  kriteriaId String
  kode       String        @unique
  nama       String
  deskripsi  String?
  tipe       IndikatorTipe @default(POSITIF)
  urutan     Int
  aktif      Boolean       @default(true)

  kriteria Kriteria           @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)
  jawaban  JawabanKuesioner[]
  topsisDetails TopsisDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kriteriaId])
  @@index([aktif])
  @@index([urutan])
  @@map("indikator")
}

model JawabanKuesioner {
  id String @id @default(cuid())

  pengajuanId String
  indikatorId String

  nilai Decimal @db.Decimal(10, 4)

  pengajuan Pengajuan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  indikator Indikator @relation(fields: [indikatorId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pengajuanId, indikatorId])
  @@index([pengajuanId])
  @@index([indikatorId])
  @@map("jawabankuesioner")
}

model SubKriteria {
  id String @id @default(cuid())

  kriteriaId String

  nama       String
  nilai      Decimal @db.Decimal(8, 4)
  keterangan String?

  kriteria Kriteria @relation(fields: [kriteriaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kriteriaId, nama])
  @@index([kriteriaId])
  @@map("subkriteria")
}

model Verifikasi {
  id String @id @default(cuid())

  pengajuanId String
  adminId     String

  status  VerifikasiStatus
  catatan String?

  pengajuan Pengajuan @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  admin     User      @relation("Verifier", fields: [adminId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pengajuanId])
  @@index([adminId])
  @@map("verifikasi")
}

model TopsisResult {
  id String @id @default(cuid())

  pengajuanId String

  nilaiPreferensi Decimal         @db.Decimal(10, 6)
  ranking         Int
  status          PengajuanStatus

  tanggalProses DateTime @default(now())

  pengajuan Pengajuan      @relation(fields: [pengajuanId], references: [id], onDelete: Cascade)
  details   TopsisDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pengajuanId])
  @@index([tanggalProses, ranking])
  @@map("topsisresult")
}

model TopsisDetail {
  id String @id @default(cuid())

  topsisResultId String
  indikatorId    String

  nilaiAwal        Decimal @db.Decimal(10, 6)
  nilaiNormalisasi Decimal @db.Decimal(12, 8)
  nilaiTerbobot    Decimal @db.Decimal(12, 8)

  topsisResult TopsisResult @relation(
    fields: [topsisResultId],
    references: [id],
    onDelete: Cascade
  )

  indikator Indikator @relation(
    fields: [indikatorId],
    references: [id],
    onDelete: Restrict
  )

  createdAt DateTime @default(now())

  @@unique([topsisResultId, indikatorId])
  @@index([indikatorId])
  @@index([topsisResultId])
  @@map("topsisdetail")
}

model AuditLog {
  id String @id @default(cuid())

  userId String?

  action   String
  entity   String
  entityId String?

  metadata Json?

  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@map("auditlog")
}